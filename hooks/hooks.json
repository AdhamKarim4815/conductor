{
  "description": "Loads the Conductor operating rules at the start of every session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.md\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
